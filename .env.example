# PULSE — environment template (committed; NO real secrets).
# Copy to `.env` at the repo root and fill in real values. `.env` is git-ignored.
# Validated at startup by apps/web/src/env.ts (Zod, fail-fast — T-15).

# ── Database (T-09/T-10) ─────────────────────────────────────────────────────
# Consumed by the Prisma driver adapter and Docker Compose. Credentials must
# match docker-compose.yml (which reads POSTGRES_* below).
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=pulse
# Host ports 55432/55433 avoid collision with a native host PostgreSQL on 5432.
DATABASE_URL=postgresql://pulse:change_me_local_only@localhost:55432/pulse?schema=public

# Containerized test database (T-23 integration suite; separate from dev DB).
DATABASE_URL_TEST=postgresql://pulse:change_me_local_only@localhost:55433/pulse_test?schema=public

# ── Auth.js (wired in Session 3 — T-19; required from Session 2 for a stable
#    boot contract) ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=change_me_generate_a_32_byte_secret

# ── Seed-only (T-19) ─────────────────────────────────────────────────────────
# Initial password for the bootstrap Owner (owner@pulse.local), hashed by the seed
# with scrypt the first time it runs. Seed-scoped ONLY — NOT read by the app and NOT
# in the app's required env schema. Override for a real bootstrap; rotate after.
OWNER_INITIAL_PASSWORD=ChangeMe!Owner1

# The bootstrap Owner's phone — the primary sign-in identifier (the sign-in field
# accepts phone OR email). Seed-scoped ONLY; set once, preserved on re-runs.
OWNER_PHONE=01000000000
